+    lv_last.assign(nb, std::vector<signed char>(na, -1)); lv_q.assign(nb, 0); lv_x.assign(nb, 0); lv_deny.assign(nb, {}); lv_K.assign(nb, {});
+    for (int b = 0; b < nb; ++b) { lv_deny[b].assign(br_nparts[b], 0);
+        for (int s = 0; s < br_nparts[b]; ++s) lv_K[b].push_back(b < int(br_Ks.size()) && s < int(br_Ks[b].size()) ? double(br_Ks[b][s]) : 0.0); }
+    lv_t0 = env->system_timestep; lv_samples = 0;
+}
+void lv_step(SharedEnvironment* env) {
+    if (lv_on.empty()) return;
+    const int t = env->system_timestep, na = std::min(int(env->system_states.size()), int(lv_lastloc.size())), nb = int(lv_on.size());
+    std::fill(lv_stuckn.begin(), lv_stuckn.end(), 0);
+    for (int i = 0; i < na; ++i) {
+        const int loc = env->system_states[i].location;
+        if (loc != lv_lastloc[i]) { lv_lastloc[i] = loc; lv_lastmove[i] = t; }
+        if (loc < 0) continue;
+        const bool has = i < int(env->curr_task_schedule.size()) && env->curr_task_schedule[i] >= 0;
+        if (has && t - lv_lastmove[i] >= lv_stuck) for (int b = 0; b < nb; ++b) lv_stuckn[b] += lv_zone5[b][loc];
+        if (lv_mode == 2) for (int b = 0; b < nb; ++b) { lv_q[b] += lv_zone3[b][loc]; const int s = br_side[b][loc];
+            if (s >= 0) { if (lv_last[b][i] >= 0 && lv_last[b][i] != s) ++lv_x[b]; lv_last[b][i] = (signed char)s; } }
+    }
+    if (lv_mode == 1) for (int b = 0; b < nb; ++b) { const char was = lv_on[b];
+        if (!lv_on[b] && lv_stuckn[b] >= lv_on_th) lv_on[b] = 1; else if (lv_on[b] && !lv_latch && lv_stuckn[b] <= lv_off_th) lv_on[b] = 0;
+        if (was != lv_on[b]) ++lv_switches; }
+    if (lv_mode == 2) { ++lv_samples;
+        if (t - lv_t0 >= lv_win) { const double dt = t - lv_t0;
+            for (int b = 0; b < nb; ++b) { const double qavg = double(lv_q[b]) / std::max(1, lv_samples);
+                const double delay = lv_x[b] > 0 ? qavg * dt / lv_x[b] : (qavg >= 1.0 ? 1e9 : 0.0);
+                for (int s = 0; s < int(lv_K[b].size()); ++s) {
+                    if (delay > lv_target) lv_K[b][s] = std::max(lv_kmin, lv_beta * lv_K[b][s]);
+                    else if (lv_deny[b][s] > 0) lv_K[b][s] = std::min(lv_kmax, lv_K[b][s] + lv_inc);
+                    if (b < int(br_Ks.size()) && s < int(br_Ks[b].size())) br_Ks[b][s] = int(lv_K[b][s] + 1e-9);
+                    lv_deny[b][s] = 0; }
+                lv_q[b] = 0; lv_x[b] = 0; }
+            lv_t0 = t; lv_samples = 0; } }
+    static int lv_bucket = -1;
+    if (lv_trace && t / 25 != lv_bucket && !br_load.empty()) { lv_bucket = t / 25;
+        std::fprintf(stderr, "[live] t=%d mode=%d on=%d stuck=%d", t, lv_mode, int(lv_mode == 1 ? lv_on[0] : 1), lv_stuckn[0]);
+        for (size_t s = 0; s < br_load[0].size(); ++s) std::fprintf(stderr, " | side%zu L=%d K=%d", s, br_load[0][s], (0 < br_Ks.size() && s < br_Ks[0].size()) ? br_Ks[0][s] : -1);
+        std::fprintf(stderr, "\n"); }
+}
