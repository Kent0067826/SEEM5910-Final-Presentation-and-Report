+// Live-window experiment for the deck (figures/deck/demo/live_window.patch; off unless ROBOT_LIVE_MODE is set).
+// ROBOT_LIVE_MODE=1: the window of a single-door cut applies only while that door is jammed: >= ROBOT_LIVE_ON (8) stuck robots
+//   (holding an order, same cell for >= 12 ticks) within 5 walking steps of the door, the congestion monitor's rule; released at
+//   <= ROBOT_LIVE_OFF (2) stuck robots, or never with ROBOT_LIVE_LATCH=1 (round-34 idea: limit only after a jam is seen).
+// ROBOT_LIVE_MODE=2: delay-based AIMD on the single-door windows, started at the formula values; the round-38 rule of
+//   ROBOT_CUT2_AIMD: every 250 ticks, delay = robot-ticks within 3 cells of the door per crossing (Little's law); above the
+//   target (250) K <- max(8, K / 2) in both directions, otherwise K <- min(48, K + 2) where the window refused an order.
+// ROBOT_LIVE_TRACE=1 prints, every 25 ticks, the robots on the way to cut 0 (door 6 on the official room map) and its windows.
+int lv_mode = 0, lv_on_th = 8, lv_off_th = 2, lv_latch = 0, lv_stuck = 12, lv_radius = 5, lv_trace = 0;
+int lv_win = 250, lv_t0 = -1, lv_samples = 0; double lv_target = 250, lv_kmin = 8, lv_kmax = 48, lv_inc = 2, lv_beta = 0.5;
+std::vector<char> lv_on; std::vector<std::vector<char>> lv_zone5, lv_zone3; std::vector<int> lv_lastloc, lv_lastmove, lv_stuckn;
+std::vector<std::vector<signed char>> lv_last; std::vector<long long> lv_q; std::vector<int> lv_x;
+std::vector<std::vector<int>> lv_deny; std::vector<std::vector<double>> lv_K; long long lv_switches = 0;
+static double lv_envd(const char* k, double d) { const char* e = std::getenv(k); return e ? std::atof(e) : d; }
+void lv_init(SharedEnvironment* env) {
+    lv_mode = int(lv_envd("ROBOT_LIVE_MODE", 0)); lv_trace = int(lv_envd("ROBOT_LIVE_TRACE", 0));
+    lv_on_th = int(lv_envd("ROBOT_LIVE_ON", 8)); lv_off_th = int(lv_envd("ROBOT_LIVE_OFF", 2)); lv_latch = int(lv_envd("ROBOT_LIVE_LATCH", 0));
+    lv_win = int(lv_envd("ROBOT_LIVE_WIN", 250)); lv_target = lv_envd("ROBOT_LIVE_TARGET", 250); lv_kmin = lv_envd("ROBOT_LIVE_KMIN", 8);
+    lv_kmax = lv_envd("ROBOT_LIVE_KMAX", 48); lv_inc = lv_envd("ROBOT_LIVE_INC", 2); lv_beta = lv_envd("ROBOT_LIVE_BETA", 0.5);
+    lv_on.clear(); lv_zone5.clear(); lv_zone3.clear(); lv_K.clear(); lv_deny.clear(); lv_switches = 0;
+    const int nb = std::min(br_n1, int(br_side.size()));
+    if ((!lv_mode && !lv_trace) || nb <= 0) { lv_mode = 0; lv_trace = 0; return; }
+    const int n = int(env->map.size()), C = env->cols, na = env->num_of_agents;
+    lv_on.assign(nb, 0); lv_zone5.assign(nb, std::vector<char>(n, 0)); lv_zone3.assign(nb, std::vector<char>(n, 0));
+    for (int b = 0; b < nb; ++b) {
+        std::vector<int> dist(n, -1), q; size_t h = 0;
+        for (int c : br_cells[b]) { dist[c] = 0; q.push_back(c); }
+        while (h < q.size()) { const int v = q[h++]; if (dist[v] >= lv_radius) continue;
+            const int r = v / C, c = v % C; const int nbv[4] = { c + 1 < C ? v + 1 : -1, c > 0 ? v - 1 : -1, r + 1 < n / C ? v + C : -1, r > 0 ? v - C : -1 };
+            for (int u : nbv) if (u >= 0 && !env->map[u] && dist[u] < 0) { dist[u] = dist[v] + 1; q.push_back(u); } }
+        for (int v = 0; v < n; ++v) if (dist[v] >= 0) lv_zone5[b][v] = 1;
+        for (int v = 0; v < n; ++v) if (!env->map[v]) for (int c : br_cells[b]) if (std::abs(v / C - c / C) + std::abs(v % C - c % C) <= 3) { lv_zone3[b][v] = 1; break; }
+    }
